# Required
TOKEN=
MONGODB_URI=
# Global Gemini key (users only need to configure an AI chat channel)
GEMINI_API_KEY=

# Server where creator-only commands such as /addcash should be registered
DISCORD_GUILD_ID=

# Optional integrations used by selected commands.
# Public Spotify links can be played without these values, but the Spotify API
# is required to load every track from a large album or playlist.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
FACEBOOK_ACCESS_TOKEN=
FORTNITE_API_KEY=
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
# Discord user ID used for bot verification and authorized for creator-only /addcash
DISCORD_USER_ID=
BOT_API=
BACKEND=
REQUIRE_BOT_VERIFICATION=false
# Stable playback level for music engines (0-100; lower values leave headroom)
MUSIC_DEFAULT_VOLUME=90
# Optional: override Lavalink nodes using a JSON array. Configure this as a
# Replit Secret (not in this file); accepts Akeno's url/auth fields or
# Riffy's host/port/password fields.
# LAVALINK_NODES_JSON=[{"name":"primary","url":"node.example.com:443","auth":"<node-password>","secure":true}]
# Optional search source; ytsearch is compatible with more Lavalink nodes.
# LAVALINK_SEARCH_PLATFORM=ytsearch